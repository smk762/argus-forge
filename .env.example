# ── Server ───────────────────────────────────────────────────────────
# Host port for the argus-forge FastAPI server (peer to lens :8100,
# curator :8101, quarry :8102).
FORGE_PORT=8103

# Host directory holding the curator's exports. Mounted at /data/out, which is
# the containment root for every request path: forge refuses an export_dir that
# does not resolve under it.
FORGE_OUTPUT_PATH=./out

# ── Demo-safe mode ───────────────────────────────────────────────────
# 1 = render configs but never train and never write: POST /run is refused with
# 403, and so is a POST /config that isn't a dry run. Defaults to 1: the default image
# ships no trainer, and the port is published on 0.0.0.0 — a run is real code
# execution on the host. The train image keeps the same default. Set to 0 only
# on a trusted host with a trainer (the train image, or one you mounted).
ARGUS_FORGE_READONLY=1

# ── Training image ───────────────────────────────────────────────────
# Build target for the local compose build: `runtime` (default) is the thin
# config-renderer; `train` bakes in torch + accelerate + kohya sd-scripts
# (multi-GB build) so POST /run can go live. The published equivalent is
# ghcr.io/smk762/argus-forge:<version>-train. Live runs additionally need
# ARGUS_FORGE_READONLY=0 and the GPU passed through (see docker-compose.yaml).
# FORGE_BUILD_TARGET=train

# ── GPU lease (training) ─────────────────────────────────────────────
# Every run (POST /run, `argus-forge run`) holds one GPU lease for the whole of
# train.sh. Unset: argus-iris (below) when ARGUS_GPU_BROKER_URL is set, else
# none (start at once). Set it only to override: none | lease = the host-wide
# lock file, started once the card has room.
# ARGUS_GPU_COORDINATOR=
# Host directory holding the shared lease lock, mounted by every argus GPU
# service on this host (argus-lens and argus-curator use the same default).
ARGUS_GPU_LOCK_DIR=/tmp/argus-gpu
# How long a run waits for its lease before failing with an error event
# (seconds, default 300). Raise it to queue a run for a later window.
# ARGUS_GPU_LEASE_TIMEOUT_S=300
# The lease's footprint in MiB. Default 22000: the whole of a 24 GiB card less
# iris's headroom, so nothing else runs beside training.
# FORGE_GPU_VRAM_MB=22000

# ── argus-iris GPU broker ────────────────────────────────────────────
# The URL and the token are all it needs: iris decides when a run starts and
# evicts idle models first (the operator's schedule window for argus-forge in
# iris's policy file sets the run's priority). The tenant comes from the image's
# /app/gpu-tenant.yaml; `serve` registers it with iris at startup.
# Where iris listens, e.g. http://<GPU_HOST>:8120. Empty: no broker (unless
# the suite file below names one; ARGUS_GPU_COORDINATOR=none opts out of it).
ARGUS_GPU_BROKER_URL=
# Shared caller token (Authorization: Bearer). Secret: host .env or the suite
# file only.
ARGUS_GPU_BROKER_TOKEN=

# ── Shared settings (the suite file) ─────────────────────────────────
# Values every Argus service on this host shares (ARGUS_GPU_BROKER_URL,
# ARGUS_GPU_BROKER_TOKEN) can be written once in the suite file,
# ~/.config/argus/suite.env (mode 600; create it with
# `python -m argus_cortex.settings --init`), instead of in each repo's .env.
# Anything set here still wins; leave the two above empty to use the file's.
# Forge reads it inside the server and never passes its values to the trainer.
# Compose mounts it only when asked (read compose.suite.yaml first: the file
# must be root-owned, and the trainer's code can open a mounted file):
# COMPOSE_FILE=docker-compose.yaml:compose.suite.yaml
# Another location for the file on the host:
# ARGUS_SUITE_ENV=<CONFIG_DIR>/suite.env

# ── Browser access ───────────────────────────────────────────────────
# Comma-separated origins allowed to call the API, *in addition to* the
# localhost:3000 studio frontend the image's --cors already allows.
# FORGE_CORS_ORIGINS=https://studio.example.com
# Host names (no port) this server is reached by, e.g. morpheus. A browser page
# served from forge's own host:port (/docs) may write only when that host is an
# IP, localhost, or listed here (DNS-rebinding guard).
# FORGE_TRUSTED_HOSTS=

# ── Container <-> host paths ─────────────────────────────────────────
# Rewrite the container paths forge renders into the host paths the trainer
# will actually open, as container=host (comma-separated for several).
# Needed when forge runs in this container but the trainer runs on the host.
# FORGE_PATH_MAP=/data/out=/home/me/argus/out

# ── Version ──────────────────────────────────────────────────────────
# Stamped into the image and reported by /health. Leave unset for local builds;
# release images get the tag from CI.
# FORGE_VERSION=0.1.0

# ── Agent tooling (not read by this service) ──
# ai-code-auditor audit API base that AGENTS.md tells coding agents to use.
# Put the real host/IP in your local .env, never here.
# AI_AUDIT_PUBLIC_BASE_URL=http://<AUDIT_HOST>:8765
